# Backend server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=replace_with_a_strong_random_secret

# MySQL (replace with your own credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Root@1234
DB_NAME=cpgrams
DB_CONNECTION_LIMIT=10

# Mail credentials
EMAIL_USER=replace_email_user
EMAIL_PASS=replace_email_app_password

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=replace_cloudinary_name
CLOUDINARY_API_KEY=replace_cloudinary_key
CLOUDINARY_API_SECRET=replace_cloudinary_secret
